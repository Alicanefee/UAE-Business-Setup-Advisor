# Optional LLM fallback for the classifier. Leave empty to run fully deterministic.
# Requires `pip install openai`.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# ":memory:" rebuilds the database from data/seed on every start.
SQLITE_PATH=:memory:

# Where escalations.jsonl is written.
RECORDS_DIR=records

DEFAULT_LOCALE=en
